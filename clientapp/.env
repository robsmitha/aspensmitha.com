# Public values only - anything prefixed VITE_ is bundled into the browser build.
# Cloudflare Turnstile site key (the secret key lives server-side as Turnstile:SecretKey)
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFFxtuxmvrnc--t_

# Home/Portfolio placement photos: fixed CDN URLs, published by the Function App (Elysian placement features).
# "api" loads them through /api/portfolio as before. Switch to "cdn" only after the backfill
# (Admin › Photos › Republish site photos) has written every file under VITE_PLACEMENT_IMAGE_BASE.
VITE_PLACEMENT_IMAGE_BASE=https://images.aspensmithaphotography.com/placements/aspensmitha
VITE_PLACEMENT_SOURCE=cdn
