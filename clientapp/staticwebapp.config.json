{
    "navigationFallback": {
        "rewrite": "/index.html",
        "exclude": [
            "/robots.txt",
            "/sitemap.xml",
            "/favicon.*",
            "/assets/*",
            "/og-image.jpg"
        ]
    },
    "routes": [
        {
            "route": "/weddings",
            "redirect": "/portfolio/weddings",
            "statusCode": 301
        },
        {
            "route": "/family",
            "redirect": "/portfolio/family",
            "statusCode": 301
        },
        {
            "route": "/maternity",
            "redirect": "/portfolio/maternity",
            "statusCode": 301
        },
        {
            "route": "/seniors",
            "redirect": "/portfolio/seniors",
            "statusCode": 301
        },
        {
            "route": "/grads",
            "redirect": "/portfolio/grads",
            "statusCode": 301
        },
        {
            "route": "/events",
            "redirect": "/portfolio/events",
            "statusCode": 301
        },
        {
            "route": "/couples",
            "redirect": "/portfolio/couples",
            "statusCode": 301
        },
        {
            "route": "/couples-1",
            "redirect": "/portfolio/couples",
            "statusCode": 301
        },
        {
            "route": "/couples-portfolio",
            "redirect": "/portfolio/engagements",
            "statusCode": 301
        },
        {
            "route": "/blank-2",
            "redirect": "/contact",
            "statusCode": 301
        },
        {
            "route": "/blank-3",
            "redirect": "/investment",
            "statusCode": 301
        },
        {
            "route": "/blog",
            "redirect": "/",
            "statusCode": 301
        },
        {
            "route": "/portfolio-4/*",
            "redirect": "/portfolio",
            "statusCode": 301
        },
        {
            "route": "/about",
            "redirect": "/about-me",
            "statusCode": 301
        },
        {
            "route": "/",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/index.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio",
            "rewrite": "/portfolio.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/about-me",
            "rewrite": "/about-me.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/investment",
            "rewrite": "/investment.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/contact",
            "rewrite": "/contact.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/couples",
            "rewrite": "/portfolio/couples.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/engagements",
            "rewrite": "/portfolio/engagements.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/weddings",
            "rewrite": "/portfolio/weddings.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/maternity",
            "rewrite": "/portfolio/maternity.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/family",
            "rewrite": "/portfolio/family.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/seniors",
            "rewrite": "/portfolio/seniors.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/grads",
            "rewrite": "/portfolio/grads.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/portfolio/events",
            "rewrite": "/portfolio/events.html",
            "headers": {
                "Cache-Control": "no-cache"
            }
        },
        {
            "route": "/spending",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/budget/*",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/accounts",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/users",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/products",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/admin/*",
            "allowedRoles": [
                "authenticated"
            ]
        },
        {
            "route": "/api/manage/*",
            "allowedRoles": [
                "authenticated"
            ]
        }
    ],
    "responseOverrides": {
        "401": {
            "statusCode": 302,
            "redirect": "/.auth/login/aad"
        }
    },
    "platform": {
        "apiRuntime": "node:18"
    }
