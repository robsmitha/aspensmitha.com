{
  // The Worker for Aspen's site. It answers at https://site-aspensmitha.smithadigital.workers.dev (testing)
  // and, through the route below, at www.aspensmitha.com.
  "name": "site-aspensmitha",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,

  // A route only takes effect while the www DNS record is proxied (orange cloud). With the record set to
  // DNS only (grey cloud) it does nothing and www goes wherever the record points, so that one toggle is
  // both the cutover and the rollback. The bare domain and aspensmithaphotography.com redirect to www with
  // Cloudflare redirect rules and never reach this Worker.
  "routes": [{ "pattern": "www.aspensmitha.com/*", "zone_name": "aspensmitha.com" }],

  "assets": {
    // Built by: yarn --cwd ../clientapp build:worker
    "directory": "../clientapp/dist",
    "binding": "ASSETS",
    // Pages, scripts and images that exist are served straight from static assets, so nothing sits between
    // the browser and the page. The Worker runs for the API and for paths with no file behind them.
    "run_worker_first": ["/api/*"],
    // /contact serves contact.html, /portfolio/weddings serves portfolio/weddings.html: the prerendered pages
    "html_handling": "auto-trailing-slash",
    // A path with no file behind it goes to the Worker, which serves the app for app routes (a story, a
    // booking page), redirects the old /admin addresses and answers 404 for a missing file under /assets. The built-in single-page fallback can't tell
    // those apart: it answers a missing script with the app's HTML.
    "not_found_handling": "none"
  },

  "vars": {
    "ELYSIAN_ORIGIN": "https://elysian-sites.azurewebsites.net"
  },

  // ELYSIAN_EDGE_CREDENTIAL is a secret: npx wrangler secret put ELYSIAN_EDGE_CREDENTIAL
  "observability": { "enabled": true }
}
